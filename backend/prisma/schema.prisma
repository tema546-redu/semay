generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  MANAGER
  STAFF
  WAITER
  KITCHEN
  TEACHER
  STUDENT
  DIRECTOR
  PARENT
}

enum BusinessType {
  RESTAURANT
  CAFE
  BAKERY
  HOTEL
  SUPERMARKET
  GYM
  SCHOOL
  UNIVERSITY
  PHARMACY
  SALON
  OTHER
  LIBRARY
  SUBCITY
  GARMENT
}

enum OrderStatus {
  OPEN
  SENT
  PREPARING
  READY
  PAID
  CANCELLED
}

enum ItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
}

enum SubscriptionPlan {
  MONTHLY
  THREE_MONTHS
  SIX_MONTHS
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
  PENDING_PAYMENT
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  name             String
  phone            String?
  avatarUrl        String?
  role             Role              @default(STAFF)
  preferredLang    String            @default("en")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organizationId   String?
  organization     Organization?     @relation(fields: [organizationId], references: [id])
  orders           Order[]           @relation("StaffOrders")
  student          Student?
  teacher          Teacher?
  aiChats          AiMessage[]
  staffAttendances StaffAttendance[]
  branchId         String?
  salonStylist     SalonStylist?
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  orgMemberships   OrgMembership[]

  @@index([organizationId])
  @@index([email])
}

model Organization {
  id           String       @id @default(cuid())
  name         String
  type         BusinessType
  address      String?
  city         String?
  country      String       @default("Ethiopia")
  phone        String?
  currency     String       @default("ETB")
  logo         String?
  photoUrl     String?
  tin          String?
  isGovernment Boolean      @default(false)
  latitude     Float?
  longitude    Float?
  openTime     String?      @default("08:00")
  closeTime    String?      @default("22:00")
  isOpen       Boolean      @default(true)
  inviteCode   String?      @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users                   User[]
  subscription            Subscription?
  menuItems               MenuItem[]
  orders                  Order[]
  school                  School?
  invites                 Invite[]
  rooms                   HotelRoom[]
  gymMembers              GymMember[]
  membershipPlans         MembershipPlan[]
  gymClasses              GymClass[]
  reservations            Reservation[]
  diningTables            DiningTable[]
  expenses                Expense[]
  bakeryProducts          BakeryProduct[]
  bakeryProductions       BakeryProduction[]
  bakeryWastes            BakeryWaste[]
  bakerySales             BakerySale[]
  pharmacyProducts        PharmacyProduct[]
  pharmacySales           PharmacySale[]
  stockItems              StockItem[]
  branches                Branch[]
  books                   Book[]
  libraryVisits           LibraryVisit[]
  bookLoans               BookLoan[]
  libraryTables           LibraryTable[]
  tableReservations       TableReservation[]
  libraryStudents         LibraryStudent[]
  libraryAttendance       LibraryAttendance[]
  libraryReviews          LibraryReview[]
  orgMemberships          OrgMembership[]
  salonServices           SalonService[]
  salonStylists           SalonStylist[]
  appointments            Appointment[]
  salonSales              SalonSale[]
  salonReviews            SalonReview[]
  garmentStyles           GarmentStyle[]
  garmentMaterials        GarmentMaterial[]
  garmentProductionOrders GarmentProductionOrder[]
  parentId                String?
  parent                  Organization?            @relation("OrgTree", fields: [parentId], references: [id], onDelete: SetNull)
  children                Organization[]           @relation("OrgTree")
}

model Subscription {
  id             String             @id @default(cuid())
  plan           SubscriptionPlan
  status         SubscriptionStatus @default(TRIAL)
  amount         Decimal            @db.Decimal(12, 2)
  currency       String             @default("ETB")
  startDate      DateTime           @default(now())
  endDate        DateTime
  createdAt      DateTime           @default(now())
  paymentReceipt String?
  paymentRef     String?
  paymentMethod  String?
  paidAmount     Decimal?           @db.Decimal(12, 2)
  organizationId String             @unique
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([status])
}

model MenuItem {
  id             String       @id @default(cuid())
  name           String
  nameAm         String?
  category       String
  imageUrl       String?
  price          Decimal      @db.Decimal(10, 2)
  description    String?
  available      Boolean      @default(true)
  stockQty       Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  orderItems     OrderItem[]
  recipeLines    RecipeLine[]
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, category])
  @@index([available])
}

model Order {
  id                 String       @id @default(cuid())
  tableNumber        String?
  status             OrderStatus  @default(OPEN)
  total              Decimal      @default(0) @db.Decimal(10, 2)
  paymentMethod      String?
  paymentReceipt     String?
  paidAt             DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  staffId            String?
  staff              User?        @relation("StaffOrders", fields: [staffId], references: [id])
  items              OrderItem[]
  branchId           String?
  branch             Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  receiptCode        String?      @unique
  receiptToken       String?
  receiptPrintedAt   DateTime?
  receiptPrintCount  Int          @default(0)
  receiptScannedAt   DateTime?
  receiptScannedById String?

  @@index([organizationId])
  @@index([organizationId, status, createdAt])
  @@index([staffId])
  @@index([createdAt])
}

model OrderItem {
  id         String     @id @default(cuid())
  name       String
  quantity   Int
  price      Decimal    @db.Decimal(10, 2)
  modifiers  String[]
  notes      String?
  status     ItemStatus @default(PENDING)
  orderId    String
  order      Order      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  menuItemId String?
  menuItem   MenuItem?  @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@index([menuItemId])
  @@index([status])
}

model Invite {
  id             String       @id @default(cuid())
  code           String       @unique
  email          String?
  role           Role
  used           Boolean      @default(false)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([code])
  @@index([expiresAt])
}

// ——— School ———
model School {
  id             String       @id @default(cuid())
  name           String
  nameAm         String?
  level          String
  qrCode         String       @unique @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  grades         Grade[]
  students       Student[]
  teachers       Teacher[]

  @@index([organizationId])
}

model Grade {
  id       String    @id @default(cuid())
  name     String
  nameAm   String?
  level    Int?
  schoolId String
  school   School    @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  students Student[]
  subjects Subject[]

  @@index([schoolId])
}

model Subject {
  id      String  @id @default(cuid())
  name    String
  nameAm  String?
  gradeId String
  grade   Grade   @relation(fields: [gradeId], references: [id], onDelete: SetNull)

  @@index([gradeId])
}

model Student {
  id          String       @id @default(cuid())
  studentId   String?
  fullName    String
  fullNameAm  String?
  gender      String?
  dateOfBirth DateTime?
  userId      String?      @unique
  user        User?        @relation(fields: [userId], references: [id])
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  gradeId     String?
  grade       Grade?       @relation(fields: [gradeId], references: [id])
  attendances Attendance[]

  @@index([schoolId])
  @@index([gradeId])
  @@index([userId])
}

model Teacher {
  id         String  @id @default(cuid())
  fullName   String
  fullNameAm String?
  subject    String?
  userId     String? @unique
  user       User?   @relation(fields: [userId], references: [id])
  schoolId   String
  school     School  @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([userId])
}

/**
 * School student attendance only
 */
model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  date      DateTime
  status    String   @default("PRESENT")
  note      String?
  createdAt DateTime @default(now())

  @@unique([studentId, date])
  @@index([studentId, date])
}

/**
 * Restaurant / café / bakery staff attendance
 */
model StaffAttendance {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  date           DateTime
  status         String    @default("PRESENT")
  note           String?
  checkIn        DateTime?
  checkOut       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([userId, date])
  @@index([organizationId, date])
  @@index([userId])
}

// ——— Hotel ———
model HotelRoom {
  id             String       @id @default(cuid())
  number         String
  type           String
  price          Decimal      @db.Decimal(10, 2)
  status         String       @default("available")
  floor          Int?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([status])
}

model AiMessage {
  id        String   @id @default(cuid())
  role      String
  content   String
  context   String?
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

// ——— Gym ———
model GymMember {
  id             String       @id @default(cuid())
  fullName       String
  fullNameAm     String?
  phone          String?
  email          String?
  status         String       @default("active")
  joinDate       DateTime     @default(now())
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  memberships    Membership[]
  checkIns       GymCheckIn[]

  @@index([organizationId])
  @@index([status])
}

model MembershipPlan {
  id             String       @id @default(cuid())
  name           String
  nameAm         String?
  type           String
  price          Decimal      @db.Decimal(10, 2)
  durationDays   Int?
  classCredits   Int?
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  memberships    Membership[]

  @@index([organizationId])
  @@index([active])
}

/// Gym: a person on a gym plan
model Membership {
  id            String         @id @default(cuid())
  startDate     DateTime       @default(now())
  endDate       DateTime?
  status        String         @default("active")
  paymentStatus String         @default("paid")
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberId      String
  member        GymMember      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  planId        String
  plan          MembershipPlan @relation(fields: [planId], references: [id])

  @@index([memberId])
  @@index([planId])
  @@index([status])
}

model GymCheckIn {
  id             String    @id @default(cuid())
  checkedInAt    DateTime  @default(now())
  method         String    @default("manual")
  memberId       String
  member         GymMember @relation(fields: [memberId], references: [id], onDelete: SetNull)
  organizationId String

  @@index([memberId])
  @@index([organizationId])
  @@index([checkedInAt])
}

model OrgMembership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  role           Role         @default(OWNER)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model GymClass {
  id             String       @id @default(cuid())
  name           String
  nameAm         String?
  coach          String?
  dayOfWeek      Int
  startTime      String
  endTime        String
  capacity       Int          @default(20)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([dayOfWeek])
  @@index([active])
}

model Reservation {
  id             String       @id @default(cuid())
  guestName      String
  phone          String?
  partySize      Int
  reservedAt     DateTime
  tableNumber    String?
  notes          String?
  status         String       @default("CONFIRMED")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([reservedAt])
  @@index([status])
}

model DiningTable {
  id             String       @id @default(cuid())
  name           String
  seats          Int          @default(4)
  status         String       @default("free")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([status])
}

model Expense {
  id             String       @id @default(cuid())
  name           String
  amount         Decimal      @db.Decimal(12, 2)
  note           String?
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
}

model BakeryProduct {
  id             String       @id @default(cuid())
  name           String
  nameAm         String?
  price          Decimal      @db.Decimal(12, 2)
  stockQty       Int          @default(0)
  available      Boolean      @default(true)
  category       String       @default("Bread")
  imageUrl       String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([available])
}

model BakeryProduction {
  id             String       @id @default(cuid())
  productId      String
  productName    String
  quantity       Int
  note           String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([productId])
  @@index([createdAt])
}

model BakeryWaste {
  id             String       @id @default(cuid())
  productId      String
  productName    String
  quantity       Int
  reason         String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([productId])
  @@index([createdAt])
}

model BakerySale {
  id             String           @id @default(cuid())
  tableOrCounter String           @default("Counter")
  total          Decimal          @db.Decimal(12, 2)
  paymentMethod  String?
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  staffId        String?
  createdAt      DateTime         @default(now())
  items          BakerySaleItem[]

  @@index([organizationId])
  @@index([createdAt])
}

model BakerySaleItem {
  id        String     @id @default(cuid())
  saleId    String
  sale      BakerySale @relation(fields: [saleId], references: [id], onDelete: SetNull)
  productId String?
  name      String
  quantity  Int
  price     Decimal    @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
}

model Feedback {
  id             String    @id @default(cuid())
  message        String
  email          String?
  organizationId String?
  userId         String?
  reply          String?
  repliedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@index([createdAt])
}

model PharmacyProduct {
  id             String             @id @default(cuid())
  name           String
  nameAm         String?
  sku            String?
  category       String             @default("General")
  price          Decimal            @db.Decimal(12, 2)
  costPrice      Decimal?           @db.Decimal(12, 2)
  stockQty       Int                @default(0)
  reorderLevel   Int                @default(10)
  expiryDate     DateTime?
  unit           String             @default("pcs")
  available      Boolean            @default(true)
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  saleItems      PharmacySaleItem[]

  @@index([organizationId])
  @@index([organizationId, name])
  @@index([sku])
  @@index([expiryDate])
}

model PharmacySale {
  id             String             @id @default(cuid())
  total          Decimal            @db.Decimal(12, 2)
  paymentMethod  String?
  note           String?
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  staffId        String?
  createdAt      DateTime           @default(now())
  items          PharmacySaleItem[]

  @@index([organizationId])
  @@index([createdAt])
}

model PharmacySaleItem {
  id        String           @id @default(cuid())
  saleId    String
  sale      PharmacySale     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  productId String?
  product   PharmacyProduct? @relation(fields: [productId], references: [id])
  name      String
  quantity  Int
  price     Decimal          @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
}

model StockItem {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  unit           String       @default("kg")
  quantity       Decimal      @db.Decimal(14, 3)
  lowAt          Decimal?     @db.Decimal(14, 3)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  recipeLines    RecipeLine[]

  @@index([organizationId])
  @@index([branchId])
  @@index([name])
}

model RecipeLine {
  id          String    @id @default(cuid())
  menuItemId  String
  stockItemId String
  qtyPerSale  Decimal   @db.Decimal(14, 4)
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: SetNull)

  @@unique([menuItemId, stockItemId])
  @@index([menuItemId])
  @@index([stockItemId])
}

model Branch {
  id             String       @id @default(cuid())
  name           String
  address        String?
  phone          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  users          User[]
  menuItems      MenuItem[]
  orders         Order[]
  invites        Invite[]
  stockItems     StockItem[]

  @@index([organizationId])
}

model Book {
  id              String       @id @default(cuid())
  title           String
  author          String?
  isbn            String?
  category        String?
  imageUrl        String?
  copiesTotal     Int          @default(1)
  copiesAvailable Int          @default(1)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  loans           BookLoan[]

  @@index([organizationId])
  @@index([isbn])
  @@index([category])
}

model LibraryVisit {
  id             String       @id @default(cuid())
  visitorName    String
  phone          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, visitorName])
}

model BookLoan {
  id             String       @id @default(cuid())
  bookId         String
  book           Book         @relation(fields: [bookId], references: [id], onDelete: SetNull)
  borrowerName   String
  nationalId     String
  phone          String?
  dueAt          DateTime?
  returnedAt     DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([bookId])
  @@index([dueAt])
  @@index([returnedAt])
}

model LibraryTable {
  id             String             @id @default(cuid())
  label          String
  seats          Int                @default(4)
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  reservations   TableReservation[]

  @@index([organizationId])
}

model TableReservation {
  id             String       @id @default(cuid())
  tableId        String
  table          LibraryTable @relation(fields: [tableId], references: [id], onDelete: SetNull)
  guestName      String
  startsAt       DateTime
  endsAt         DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([tableId])
  @@index([startsAt])
}

model LibraryStudent {
  id             String              @id @default(cuid())
  fullName       String
  studentCode    String?
  grade          String?
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  attendance     LibraryAttendance[]
  createdAt      DateTime            @default(now())

  @@index([organizationId])
  @@index([studentCode])
}

model LibraryAttendance {
  id             String         @id @default(cuid())
  studentId      String
  student        LibraryStudent @relation(fields: [studentId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  date           DateTime       @default(now())
  checkedInAt    DateTime       @default(now())

  @@unique([studentId, date])
  @@index([organizationId, date])
  @@index([studentId])
}

model LibraryReview {
  id             String       @id @default(cuid())
  visitorName    String
  rating         Int
  comment        String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([createdAt])
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  IN_PROGRESS
  DONE
  CANCELLED
  NO_SHOW
}

model SalonService {
  id             String          @id @default(cuid())
  name           String
  nameAm         String?
  category       String          @default("General")
  durationMin    Int             @default(30)
  price          Decimal         @db.Decimal(10, 2)
  active         Boolean         @default(true)
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  appointments   Appointment[]
  saleItems      SalonSaleItem[]

  @@index([organizationId])
  @@index([organizationId, category])
}

model SalonStylist {
  id             String          @id @default(cuid())
  userId         String?         @unique
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName       String
  phone          String?
  specialty      String?
  commissionPct  Decimal         @default(0) @db.Decimal(5, 2)
  active         Boolean         @default(true)
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  appointments   Appointment[]
  saleItems      SalonSaleItem[]

  @@index([organizationId])
  @@index([userId])
}

model Appointment {
  id             String            @id @default(cuid())
  clientName     String
  clientPhone    String?
  serviceId      String
  service        SalonService      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  stylistId      String?
  stylist        SalonStylist?     @relation(fields: [stylistId], references: [id], onDelete: SetNull)
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(BOOKED)
  notes          String?
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId, startsAt])
  @@index([stylistId, startsAt])
  @@index([status])
}

model SalonSale {
  id             String          @id @default(cuid())
  total          Decimal         @db.Decimal(12, 2)
  paymentMethod  String?
  appointmentId  String?
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  staffId        String?
  createdAt      DateTime        @default(now())
  items          SalonSaleItem[]

  @@index([organizationId])
  @@index([createdAt])
}

model SalonSaleItem {
  id        String        @id @default(cuid())
  saleId    String
  sale      SalonSale     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  serviceId String?
  service   SalonService? @relation(fields: [serviceId], references: [id])
  stylistId String?
  stylist   SalonStylist? @relation(fields: [stylistId], references: [id])
  name      String
  price     Decimal       @db.Decimal(12, 2)
  quantity  Int           @default(1)

  @@index([saleId])
  @@index([serviceId])
  @@index([stylistId])
}

model SalonReview {
  id             String       @id @default(cuid())
  clientName     String
  rating         Int
  comment        String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([createdAt])
}

// ========== GARMENT MODULE ==========

enum GarmentMaterialCategory {
  RAW_MATERIAL
  ACCESSORY
  PACKAGING
  FINISHED_GOOD
}

enum ProductionStage {
  PLANNED
  CUTTING
  SEWING
  QUALITY
  FINISHING
  PACKING
  COMPLETED
  CANCELLED
}

enum ProductionStatus {
  ON_TRACK
  AT_RISK
  DELAYED
  COMPLETED
}

model GarmentStyle {
  id             String       @id @default(cuid())
  name           String
  nameAm         String?
  sku            String?
  category       String?
  description    String?
  imageUrl       String?
  active         Boolean      @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  variants         GarmentVariant[]
  bomItems         GarmentBOMItem[]
  productionOrders GarmentProductionOrder[]

  @@index([organizationId])
  @@index([sku])
}

model GarmentVariant {
  id        String       @id @default(cuid())
  styleId   String
  style     GarmentStyle @relation(fields: [styleId], references: [id], onDelete: Cascade)
  size      String
  color     String
  colorAm   String?
  sku       String?
  barcode   String?
  price     Decimal      @default(0) @db.Decimal(12, 2)
  createdAt DateTime     @default(now())

  @@unique([styleId, size, color])
  @@index([styleId])
}

model GarmentMaterial {
  id             String                  @id @default(cuid())
  name           String
  nameAm         String?
  category       GarmentMaterialCategory
  unit           String // m, pcs, kg, roll...
  currentStock   Decimal                 @default(0) @db.Decimal(14, 3)
  minLevel       Decimal?                @db.Decimal(14, 3)
  costPerUnit    Decimal?                @db.Decimal(12, 2)
  note           String?
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  bomItems GarmentBOMItem[]

  @@index([organizationId])
  @@index([category])
}

model GarmentBOMItem {
  id         String          @id @default(cuid())
  styleId    String
  style      GarmentStyle    @relation(fields: [styleId], references: [id], onDelete: Cascade)
  materialId String
  material   GarmentMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  qtyNeeded  Decimal         @db.Decimal(14, 4) // quantity needed per one piece
  createdAt  DateTime        @default(now())

  @@unique([styleId, materialId])
  @@index([styleId])
  @@index([materialId])
}

model GarmentProductionOrder {
  id             String           @id @default(cuid())
  orderNumber    String
  styleId        String
  style          GarmentStyle     @relation(fields: [styleId], references: [id])
  customerName   String?
  dueDate        DateTime?
  plannedQty     Int
  actualQty      Int              @default(0)
  stage          ProductionStage  @default(PLANNED)
  status         ProductionStatus @default(ON_TRACK)
  notes          String?
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  stageLogs GarmentStageLog[]

  @@index([organizationId])
  @@index([stage])
  @@index([status])
  @@index([dueDate])
}

model GarmentStageLog {
  id          String                 @id @default(cuid())
  orderId     String
  order       GarmentProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage       ProductionStage
  quantity    Int
  note        String?
  createdAt   DateTime               @default(now())
  createdById String?

  @@index([orderId])
}
