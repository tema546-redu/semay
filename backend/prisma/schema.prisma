generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  STAFF
  WAITER
  KITCHEN
  TEACHER
  STUDENT
  DIRECTOR
  PARENT
}

enum BusinessType {
  RESTAURANT
  CAFE
  BAKERY
  HOTEL
  SUPERMARKET
  GYM
  SCHOOL
  UNIVERSITY
  PHARMACY
  SALON
  OTHER
}

enum OrderStatus {
  OPEN
  SENT
  PREPARING
  READY
  PAID
  CANCELLED
}

enum ItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
}

enum SubscriptionPlan {
  MONTHLY
  THREE_MONTHS
  SIX_MONTHS
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
  PENDING_PAYMENT
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  phone         String?
  avatarUrl     String?
  role          Role     @default(STAFF)
  preferredLang String   @default("en")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  orders   Order[]   @relation("StaffOrders")
  student  Student?
  teacher  Teacher?
  aiChats  AiMessage[]
}

model Organization {
  id        String       @id @default(cuid())
  name      String
  type      BusinessType
  address   String?
  city      String?
  country   String       @default("Ethiopia")
  phone     String?
  currency  String       @default("ETB")
  openTime  String?      // "08:00"
  closeTime String?      // "22:00"
  logo      String?
  latitude  Float?
  longitude Float?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users        User[]
  subscription Subscription?
  menuItems    MenuItem[]
  orders       Order[]
  school       School?
  invites      Invite[]
  rooms        HotelRoom[]
  gymMembers   GymMember[]
  membershipPlans MembershipPlan[]
  gymClasses     GymClass[]
  reservations  Reservation[]
  diningTables DiningTable[]
  expenses     Expense[]
}

model Subscription {
  id        String             @id @default(cuid())
  plan      SubscriptionPlan
  status    SubscriptionStatus @default(TRIAL)
  amount    Decimal            @db.Decimal(12, 2)
  currency  String             @default("ETB")
  startDate DateTime           @default(now())
  endDate   DateTime
  createdAt DateTime           @default(now())
  
  paymentReceipt  String?
  paymentRef     String?
  paymentMethod  String?
  paidAmount     Decimal? @db.Decimal(12, 2)

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  nameAm      String?
  category    String
  imageUrl    String?
  price       Decimal  @db.Decimal(10, 2)
  description String?
  available   Boolean  @default(true)
  stockQty    Int?     // null = unlimited
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
}

model Order {
  id          String      @id @default(cuid())
  tableNumber String?
  status      OrderStatus @default(OPEN)
  total       Decimal     @db.Decimal(10, 2) @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffId        String?
  staff          User?        @relation("StaffOrders", fields: [staffId], references: [id])
  items          OrderItem[]
  paymentMethod String?
}

model OrderItem {
  id        String     @id @default(cuid())
  name      String
  quantity  Int
  price     Decimal    @db.Decimal(10, 2)
  modifiers String[]
  notes     String?
  status    ItemStatus @default(PENDING)

  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id])
}

model Invite {
  id             String   @id @default(cuid())
  code           String   @unique
  email          String?
  role           Role
  used           Boolean  @default(false)
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// School
model School {
  id     String  @id @default(cuid())
  name   String
  nameAm String?
  level  String
  qrCode String  @unique @default(cuid())

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  grades   Grade[]
  students Student[]
  teachers Teacher[]
}

model Grade {
  id     String  @id @default(cuid())
  name   String
  nameAm String?
  level  Int?

  schoolId String
  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students Student[]
  subjects Subject[]
}

model Subject {
  id     String  @id @default(cuid())
  name   String
  nameAm String?

  gradeId String
  grade   Grade @relation(fields: [gradeId], references: [id], onDelete: Cascade)
}

model Student {
  id          String    @id @default(cuid())
  studentId   String?
  fullName    String
  fullNameAm  String?
  gender      String?
  dateOfBirth DateTime?

  userId   String? @unique
  user     User?   @relation(fields: [userId], references: [id])
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeId  String?
  grade    Grade?  @relation(fields: [gradeId], references: [id])

  attendances Attendance[]
}

model Teacher {
  id         String  @id @default(cuid())
  fullName   String
  fullNameAm String?
  subject    String?

  userId   String? @unique
  user     User?   @relation(fields: [userId], references: [id])
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model Attendance {
  id     String   @id @default(cuid())
  date   DateTime @default(now())
  status String
  note   String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// Hotel
model HotelRoom {
  id         String  @id @default(cuid())
  number     String
  type       String  // single, double, suite
  price      Decimal @db.Decimal(10, 2)
  status     String  @default("available") // available, occupied, cleaning
  floor      Int?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}


// Semay AI
model AiMessage {
  id        String   @id @default(cuid())
  role      String   // user | assistant
  content   String
  context   String?  // restaurant | school | general
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])
}

// ========== GYM MODULE (Phase 3) ==========

model GymMember {
  id            String    @id @default(cuid())
  fullName      String
  fullNameAm    String?
  phone         String?
  email         String?
  status        String    @default("active") // active, frozen, expired, cancelled
  joinDate      DateTime  @default(now())
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  checkIns       GymCheckIn[]
}

model MembershipPlan {
  id          String   @id @default(cuid())
  name        String
  nameAm      String?
  type        String   // monthly, annual, class_pack, drop_in
  price       Decimal  @db.Decimal(10, 2)
  durationDays Int?    // for time-based
  classCredits Int?    // for pack-based
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]
}

model Membership {
  id          String    @id @default(cuid())
  startDate   DateTime  @default(now())
  endDate     DateTime?
  status      String    @default("active") // active, frozen, expired, cancelled
  paymentStatus String  @default("paid") // paid, pending, failed
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberId    String
  member      GymMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId      String
  plan        MembershipPlan @relation(fields: [planId], references: [id])
}

model GymCheckIn {
  id        String   @id @default(cuid())
  checkedInAt DateTime @default(now())
  method    String   @default("manual") // manual, qr, kiosk

  memberId  String
  member    GymMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  organizationId String
}


model GymClass {
  id          String   @id @default(cuid())
  name        String
  nameAm      String?
  coach       String?
  dayOfWeek   Int      // 0=Sun .. 6=Sat
  startTime   String   // "07:00"
  endTime     String   // "08:00"
  capacity    Int      @default(20)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}


model Reservation {
  id             String   @id @default(cuid())
  guestName      String
  phone          String?
  partySize      Int
  reservedAt     DateTime
  tableNumber    String?
  notes          String?
  status         String   @default("CONFIRMED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model DiningTable {
  id             String   @id @default(cuid())
  name           String
  seats          Int      @default(4)
  status         String   @default("free") // free | busy | reserved
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

model Expense {
  id             String   @id @default(cuid())
  name           String
  amount         Decimal  @db.Decimal(12, 2)
  note           String?
  createdAt      DateTime @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}