generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  MANAGER
  STAFF
  WAITER
  KITCHEN
  TEACHER
  STUDENT
  DIRECTOR
  PARENT
}

enum BusinessType {
  RESTAURANT
  CAFE
  BAKERY
  HOTEL
  SUPERMARKET
  GYM
  SCHOOL
  UNIVERSITY
  PHARMACY
  SALON
  OTHER
}

enum OrderStatus {
  OPEN
  SENT
  PREPARING
  READY
  PAID
  CANCELLED
}

enum ItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
}

enum SubscriptionPlan {
  MONTHLY
  THREE_MONTHS
  SIX_MONTHS
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
  PENDING_PAYMENT
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String
  phone          String?
  avatarUrl      String?
  role           Role      @default(STAFF)
  preferredLang  String    @default("en")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  orders             Order[]           @relation("StaffOrders")
  student            Student?
  teacher            Teacher?
  aiChats            AiMessage[]
  staffAttendances   StaffAttendance[]
}

model Organization {
  id        String       @id @default(cuid())
  name      String
  type      BusinessType
  address   String?
  city      String?
  country   String       @default("Ethiopia")
  phone     String?
  currency  String       @default("ETB")
  logo      String?
  latitude  Float?
  longitude Float?
  openTime  String?      @default("08:00")
  closeTime String?      @default("22:00")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users             User[]
  subscription      Subscription?
  menuItems         MenuItem[]
  orders            Order[]
  school            School?
  invites           Invite[]
  rooms             HotelRoom[]
  gymMembers        GymMember[]
  membershipPlans   MembershipPlan[]
  gymClasses        GymClass[]
  reservations      Reservation[]
  diningTables      DiningTable[]
  expenses          Expense[]
  bakeryProducts    BakeryProduct[]
  bakeryProductions BakeryProduction[]
  bakeryWastes      BakeryWaste[]
  bakerySales       BakerySale[]
  pharmacyProducts PharmacyProduct[]
  pharmacySales    PharmacySale[]
  stockItems StockItem[]
}

model Subscription {
  id             String             @id @default(cuid())
  plan           SubscriptionPlan
  status         SubscriptionStatus @default(TRIAL)
  amount         Decimal            @db.Decimal(12, 2)
  currency       String             @default("ETB")
  startDate      DateTime           @default(now())
  endDate        DateTime
  createdAt      DateTime           @default(now())
  paymentReceipt String?
  paymentRef     String?
  paymentMethod  String?
  paidAmount     Decimal?           @db.Decimal(12, 2)
  organizationId String             @unique
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model MenuItem {
  id             String   @id @default(cuid())
  name           String
  nameAm         String?
  category       String
  imageUrl       String?
  price          Decimal  @db.Decimal(10, 2)
  description    String?
  available      Boolean  @default(true)
  stockQty       Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  recipeLines RecipeLine[]
}

model Order {
  id             String      @id @default(cuid())
  tableNumber    String?
  status         OrderStatus @default(OPEN)
  total          Decimal     @db.Decimal(10, 2) @default(0)
  paymentMethod  String?
  paymentReceipt String?
  paidAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffId        String?
  staff          User?        @relation("StaffOrders", fields: [staffId], references: [id])
  items          OrderItem[]
}

model OrderItem {
  id         String     @id @default(cuid())
  name       String
  quantity   Int
  price      Decimal    @db.Decimal(10, 2)
  modifiers  String[]
  notes      String?
  status     ItemStatus @default(PENDING)
  orderId    String
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem?  @relation(fields: [menuItemId], references: [id])
}

model Invite {
  id             String   @id @default(cuid())
  code           String   @unique
  email          String?
  role           Role
  used           Boolean  @default(false)
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ——— School ———
model School {
  id             String  @id @default(cuid())
  name           String
  nameAm         String?
  level          String
  qrCode         String  @unique @default(cuid())
  organizationId String  @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grades         Grade[]
  students       Student[]
  teachers       Teacher[]
}

model Grade {
  id       String  @id @default(cuid())
  name     String
  nameAm   String?
  level    Int?
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students Student[]
  subjects Subject[]
}

model Subject {
  id      String @id @default(cuid())
  name    String
  nameAm  String?
  gradeId String
  grade   Grade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)
}

model Student {
  id          String    @id @default(cuid())
  studentId   String?
  fullName    String
  fullNameAm  String?
  gender      String?
  dateOfBirth DateTime?
  userId      String?   @unique
  user        User?     @relation(fields: [userId], references: [id])
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeId     String?
  grade       Grade?    @relation(fields: [gradeId], references: [id])
  attendances Attendance[]
}

model Teacher {
  id         String  @id @default(cuid())
  fullName   String
  fullNameAm String?
  subject    String?
  userId     String? @unique
  user       User?   @relation(fields: [userId], references: [id])
  schoolId   String
  school     School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

/** School student attendance only */
model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime
  status    String   @default("PRESENT")
  note      String?
  createdAt DateTime @default(now())

  @@unique([studentId, date])
  @@index([studentId, date])
}

/** Restaurant / café / bakery staff attendance */
model StaffAttendance {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  date           DateTime
  status         String    @default("PRESENT")
  note           String?
  checkIn        DateTime?
  checkOut       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([organizationId, date])
}

// ——— Hotel ———
model HotelRoom {
  id             String  @id @default(cuid())
  number         String
  type           String
  price          Decimal @db.Decimal(10, 2)
  status         String  @default("available")
  floor          Int?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AiMessage {
  id        String   @id @default(cuid())
  role      String
  content   String
  context   String?
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}

// ——— Gym ———
model GymMember {
  id             String    @id @default(cuid())
  fullName       String
  fullNameAm     String?
  phone          String?
  email          String?
  status         String    @default("active")
  joinDate       DateTime  @default(now())
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  checkIns       GymCheckIn[]
}

model MembershipPlan {
  id             String   @id @default(cuid())
  name           String
  nameAm         String?
  type           String
  price          Decimal  @db.Decimal(10, 2)
  durationDays   Int?
  classCredits   Int?
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]
}

model Membership {
  id            String    @id @default(cuid())
  startDate     DateTime  @default(now())
  endDate       DateTime?
  status        String    @default("active")
  paymentStatus String    @default("paid")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  memberId      String
  member        GymMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId        String
  plan          MembershipPlan @relation(fields: [planId], references: [id])
}

model GymCheckIn {
  id             String   @id @default(cuid())
  checkedInAt    DateTime @default(now())
  method         String   @default("manual")
  memberId       String
  member         GymMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  organizationId String
}

model GymClass {
  id             String   @id @default(cuid())
  name           String
  nameAm         String?
  coach          String?
  dayOfWeek      Int
  startTime      String
  endTime        String
  capacity       Int      @default(20)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Reservation {
  id             String   @id @default(cuid())
  guestName      String
  phone          String?
  partySize      Int
  reservedAt     DateTime
  tableNumber    String?
  notes          String?
  status         String   @default("CONFIRMED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model DiningTable {
  id             String   @id @default(cuid())
  name           String
  seats          Int      @default(4)
  status         String   @default("free")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

model Expense {
  id             String   @id @default(cuid())
  name           String
  amount         Decimal  @db.Decimal(12, 2)
  note           String?
  createdAt      DateTime @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model BakeryProduct {
  id             String   @id @default(cuid())
  name           String
  nameAm         String?
  price          Decimal  @db.Decimal(12, 2)
  stockQty       Int      @default(0)
  available      Boolean  @default(true)
  category       String   @default("Bread")
  imageUrl       String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BakeryProduction {
  id             String   @id @default(cuid())
  productId      String
  productName    String
  quantity       Int
  note           String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  createdAt      DateTime @default(now())
}

model BakeryWaste {
  id             String   @id @default(cuid())
  productId      String
  productName    String
  quantity       Int
  reason         String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  createdAt      DateTime @default(now())
}

model BakerySale {
  id             String   @id @default(cuid())
  tableOrCounter String   @default("Counter")
  total          Decimal  @db.Decimal(12, 2)
  paymentMethod  String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffId        String?
  createdAt      DateTime @default(now())
  items          BakerySaleItem[]
}

model BakerySaleItem {
  id        String     @id @default(cuid())
  saleId    String
  sale      BakerySale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String?
  name      String
  quantity  Int
  price     Decimal    @db.Decimal(12, 2)
}

model Feedback {
  id             String    @id @default(cuid())
  message        String
  email          String?
  organizationId String?
  userId         String?
  reply          String?
  repliedAt      DateTime?
  createdAt      DateTime  @default(now())
}

model PharmacyProduct {
  id             String    @id @default(cuid())
  name           String
  nameAm         String?
  sku            String?   // barcode / code
  category       String    @default("General")
  price          Decimal   @db.Decimal(12, 2)
  costPrice      Decimal?  @db.Decimal(12, 2)
  stockQty       Int       @default(0)
  reorderLevel   Int       @default(10)
  expiryDate     DateTime?
  unit           String    @default("pcs") // pcs, box, bottle
  available      Boolean   @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  saleItems      PharmacySaleItem[]

  @@index([organizationId, name])
}

model PharmacySale {
  id             String   @id @default(cuid())
  total          Decimal  @db.Decimal(12, 2)
  paymentMethod  String?  // cash | telebirr | cbe | card
  note           String?  // optional Rx / patient note
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffId        String?
  createdAt      DateTime @default(now())
  items          PharmacySaleItem[]
}

model PharmacySaleItem {
  id        String          @id @default(cuid())
  saleId    String
  sale      PharmacySale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String?
  product   PharmacyProduct? @relation(fields: [productId], references: [id])
  name      String
  quantity  Int
  price     Decimal         @db.Decimal(12, 2)
}

model StockItem {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  unit           String   @default("kg") // kg | L | pcs
  quantity       Decimal  @db.Decimal(14, 3)
  lowAt          Decimal? @db.Decimal(14, 3)
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipeLines  RecipeLine[]

  @@index([organizationId])
}

model RecipeLine {
  id          String  @id @default(cuid())
  menuItemId  String
  stockItemId String
  qtyPerSale  Decimal @db.Decimal(14, 4)

  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, stockItemId])
}