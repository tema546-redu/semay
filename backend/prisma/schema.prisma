model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  path      String?
  meta      Json?
  visitorId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([name])
  @@index([visitorId])
}

model ContactListing {
  id        String   @id @default(cuid())
  nameEn    String
  nameAm    String?
  phone     String
  phone2    String?
  phone3    String?
  phone4    String?
  category  String
  noteEn    String?
  noteAm    String?
  photoUrl  String?
  address   String?
  mapsUrl   String?
  website   String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([verified])
}

model DelalaContact {
  id         String   @id @default(cuid())
  name       String
  nameAm     String?
  phone      String
  phone2     String?
  phone3     String?
  phone4     String?
  city       String
  subCity    String?
  area       String?
  categories String[]
  photoUrl   String?
  address    String?
  mapsUrl    String?
  idFrontUrl String?   // admin only
  idBackUrl  String?   // admin only
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContactCategory {
  id        String   @id @default(cuid())
  key       String   @unique
  labelEn   String
  labelAm   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model DelalaCity {
  id        String   @id @default(cuid())
  name      String   @unique
  country   String   @default("Ethiopia")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}