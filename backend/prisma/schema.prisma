generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  name             String
  phone            String?
  avatarUrl        String?
  role             Role              @default(STAFF)
  preferredLang    String            @default("en")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organizationId   String?
  branchId         String?
  aiChats          AiMessage[]
  orders           Order[]           @relation("StaffOrders")
  orgMemberships   OrgMembership[]
  salonStylist     SalonStylist?
  staffAttendances StaffAttendance[]
  student          Student?
  teacher          Teacher?
  branch           Branch?           @relation(fields: [branchId], references: [id])
  organization     Organization?     @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([email])
}

model Organization {
  id                      String                   @id @default(cuid())
  name                    String
  type                    BusinessType
  address                 String?
  city                    String?
  country                 String                   @default("Ethiopia")
  phone                   String?
  currency                String                   @default("ETB")
  openTime                String?                  @default("08:00")
  closeTime               String?                  @default("22:00")
  logo                    String?
  latitude                Float?
  longitude               Float?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  tin                     String?
  inviteCode              String?                  @unique
  isOpen                  Boolean                  @default(true)
  isGovernment            Boolean                  @default(false)
  photoUrl                String?
  parentId                String?
  typeSwitchedAt          DateTime?
  appointments            Appointment[]
  bakeryProducts          BakeryProduct[]
  bakeryProductions       BakeryProduction[]
  bakerySales             BakerySale[]
  bakeryWastes            BakeryWaste[]
  books                   Book[]
  bookLoans               BookLoan[]
  branches                Branch[]
  diningTables            DiningTable[]
  expenses                Expense[]
  garmentAttendances      GarmentAttendance[]
  garmentDailyReports     GarmentDailyReport[]
  garmentDefects          GarmentDefect[]
  garmentMaterials        GarmentMaterial[]
  garmentProductionOrders GarmentProductionOrder[]
  garmentStyles           GarmentStyle[]
  garmentWorkers          GarmentWorker[]
  gymClasses              GymClass[]
  gymMembers              GymMember[]
  rooms                   HotelRoom[]
  invites                 Invite[]
  libraryAttendance       LibraryAttendance[]
  libraryReviews          LibraryReview[]
  libraryStudents         LibraryStudent[]
  libraryTables           LibraryTable[]
  libraryVisits           LibraryVisit[]
  membershipPlans         MembershipPlan[]
  menuItems               MenuItem[]
  orders                  Order[]
  orgMemberships          OrgMembership[]
  parent                  Organization?            @relation("OrgTree", fields: [parentId], references: [id])
  children                Organization[]           @relation("OrgTree")
  pharmacyProducts        PharmacyProduct[]
  pharmacySales           PharmacySale[]
  reservations            Reservation[]
  salonReviews            SalonReview[]
  salonSales              SalonSale[]
  salonServices           SalonService[]
  salonStylists           SalonStylist[]
  school                  School?
  stockItems              StockItem[]
  subscription            Subscription?
  tableReservations       TableReservation[]
  users                   User[]
}

model Subscription {
  id             String             @id @default(cuid())
  plan           SubscriptionPlan
  status         SubscriptionStatus @default(TRIAL)
  amount         Decimal            @db.Decimal(12, 2)
  currency       String             @default("ETB")
  startDate      DateTime           @default(now())
  endDate        DateTime
  createdAt      DateTime           @default(now())
  paymentReceipt String?
  paymentRef     String?
  paymentMethod  String?
  paidAmount     Decimal?           @db.Decimal(12, 2)
  organizationId String             @unique
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([status])
}

model MenuItem {
  id             String       @id @default(cuid())
  name           String
  nameAm         String?
  category       String
  imageUrl       String?
  price          Decimal      @db.Decimal(10, 2)
  description    String?
  available      Boolean      @default(true)
  stockQty       Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  branchId       String?
  station        String       @default("KITCHEN")
  branch         Branch?      @relation(fields: [branchId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  orderItems     OrderItem[]
  recipeLines    RecipeLine[]

  @@index([organizationId])
  @@index([organizationId, category])
  @@index([available])
}

model Order {
  id                 String       @id @default(cuid())
  tableNumber        String?
  status             OrderStatus  @default(OPEN)
  total              Decimal      @default(0) @db.Decimal(10, 2)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organizationId     String
  staffId            String?
  paymentMethod      String?
  paidAt             DateTime?
  paymentReceipt     String?
  branchId           String?
  receiptCode        String?      @unique
  receiptPrintCount  Int          @default(0)
  receiptPrintedAt   DateTime?
  receiptScannedAt   DateTime?
  receiptScannedById String?
  receiptToken       String?
  customerName       String?
  customerPhone      String?
  branch             Branch?      @relation(fields: [branchId], references: [id])
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  staff              User?        @relation("StaffOrders", fields: [staffId], references: [id])
  items              OrderItem[]

  @@index([organizationId])
  @@index([organizationId, status, createdAt])
  @@index([staffId])
  @@index([createdAt])
}

model OrderItem {
  id         String     @id @default(cuid())
  name       String
  quantity   Int
  price      Decimal    @db.Decimal(10, 2)
  modifiers  String[]
  notes      String?
  status     ItemStatus @default(PENDING)
  orderId    String
  menuItemId String?
  menuItem   MenuItem?  @relation(fields: [menuItemId], references: [id])
  order      Order      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([menuItemId])
  @@index([status])
}

model Invite {
  id             String       @id @default(cuid())
  code           String       @unique
  email          String?
  role           Role
  used           Boolean      @default(false)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  organizationId String
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([code])
  @@index([expiresAt])
}

model School {
  id             String       @id @default(cuid())
  name           String
  nameAm         String?
  level          String
  qrCode         String       @unique @default(cuid())
  organizationId String       @unique
  grades         Grade[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  students       Student[]
  teachers       Teacher[]

  @@index([organizationId])
}

model Grade {
  id       String    @id @default(cuid())
  name     String
  nameAm   String?
  level    Int?
  schoolId String
  school   School    @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  students Student[]
  subjects Subject[]

  @@index([schoolId])
}

model Subject {
  id      String  @id @default(cuid())
  name    String
  nameAm  String?
  gradeId String
  grade   Grade   @relation(fields: [gradeId], references: [id], onDelete: SetNull)

  @@index([gradeId])
}

model Student {
  id          String       @id @default(cuid())
  studentId   String?
  fullName    String
  fullNameAm  String?
  gender      String?
  dateOfBirth DateTime?
  userId      String?      @unique
  schoolId    String
  gradeId     String?
  attendances Attendance[]
  grade       Grade?       @relation(fields: [gradeId], references: [id])
  school      School       @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([gradeId])
  @@index([userId])
}

model Teacher {
  id         String  @id @default(cuid())
  fullName   String
  fullNameAm String?
  subject    String?
  userId     String? @unique
  schoolId   String
  school     School  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  user       User?   @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([userId])
}

/// *
///  * School student attendance only
model Attendance {
  id        String   @id @default(cuid())
  date      DateTime
  status    String   @default("PRESENT")
  note      String?
  studentId String
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([studentId, date])
}

/// *
///  * Restaurant / café / bakery staff attendance
model StaffAttendance {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  date           DateTime
  status         String    @default("PRESENT")
  note           String?
  checkIn        DateTime?
  checkOut       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([userId, date])
  @@index([organizationId, date])
  @@index([userId])
}

model HotelRoom {
  id             String       @id @default(cuid())
  number         String
  type           String
  price          Decimal      @db.Decimal(10, 2)
  status         String       @default("available")
  floor          Int?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([status])
}

model AiMessage {
  id        String   @id @default(cuid())
  role      String
  content   String
  context   String?
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model GymMember {
  id             String       @id @default(cuid())
  fullName       String
  fullNameAm     String?
  phone          String?
  email          String?
  status         String       @default("active")
  joinDate       DateTime     @default(now())
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  checkIns       GymCheckIn[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  memberships    Membership[]

  @@index([organizationId])
  @@index([status])
}

model MembershipPlan {
  id             String       @id @default(cuid())
  name           String
  nameAm         String?
  type           String
  price          Decimal      @db.Decimal(10, 2)
  durationDays   Int?
  classCredits   Int?
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  organizationId String
  memberships    Membership[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([active])
}

/// Gym: a person on a gym plan
model Membership {
  id            String         @id @default(cuid())
  startDate     DateTime       @default(now())
  endDate       DateTime?
  status        String         @default("active")
  paymentStatus String         @default("paid")
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberId      String
  planId        String
  member        GymMember      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  plan          MembershipPlan @relation(fields: [planId], references: [id])

  @@index([memberId])
  @@index([planId])
  @@index([status])
}

model GymCheckIn {
  id             String    @id @default(cuid())
  checkedInAt    DateTime  @default(now())
  method         String    @default("manual")
  memberId       String
  organizationId String
  member         GymMember @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@index([organizationId])
  @@index([checkedInAt])
}

model OrgMembership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           Role         @default(OWNER)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model GymClass {
  id             String       @id @default(cuid())
  name           String
  nameAm         String?
  coach          String?
  dayOfWeek      Int
  startTime      String
  endTime        String
  capacity       Int          @default(20)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([dayOfWeek])
  @@index([active])
}

model Reservation {
  id             String       @id @default(cuid())
  guestName      String
  phone          String?
  partySize      Int
  reservedAt     DateTime
  tableNumber    String?
  notes          String?
  status         String       @default("CONFIRMED")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([reservedAt])
  @@index([status])
}

model DiningTable {
  id             String       @id @default(cuid())
  name           String
  seats          Int          @default(4)
  status         String       @default("free")
  organizationId String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([status])
}

model Expense {
  id             String       @id @default(cuid())
  name           String
  amount         Decimal      @db.Decimal(12, 2)
  note           String?
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
}

model BakeryProduct {
  id             String       @id @default(cuid())
  name           String
  nameAm         String?
  price          Decimal      @db.Decimal(12, 2)
  stockQty       Int          @default(0)
  available      Boolean      @default(true)
  category       String       @default("Bread")
  imageUrl       String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([available])
}

model BakeryProduction {
  id             String       @id @default(cuid())
  productId      String
  productName    String
  quantity       Int
  note           String?
  organizationId String
  createdById    String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([productId])
  @@index([createdAt])
}

model BakeryWaste {
  id             String       @id @default(cuid())
  productId      String
  productName    String
  quantity       Int
  reason         String?
  organizationId String
  createdById    String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([productId])
  @@index([createdAt])
}

model BakerySale {
  id             String           @id @default(cuid())
  tableOrCounter String           @default("Counter")
  total          Decimal          @db.Decimal(12, 2)
  paymentMethod  String?
  organizationId String
  staffId        String?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  items          BakerySaleItem[]

  @@index([organizationId])
  @@index([createdAt])
}

model BakerySaleItem {
  id        String     @id @default(cuid())
  saleId    String
  productId String?
  name      String
  quantity  Int
  price     Decimal    @db.Decimal(12, 2)
  sale      BakerySale @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
}

model Feedback {
  id             String    @id @default(cuid())
  message        String
  email          String?
  organizationId String?
  userId         String?
  createdAt      DateTime  @default(now())
  repliedAt      DateTime?
  reply          String?

  @@index([organizationId])
  @@index([createdAt])
}

model PharmacyProduct {
  id             String             @id @default(cuid())
  name           String
  nameAm         String?
  sku            String?
  category       String             @default("General")
  price          Decimal            @db.Decimal(12, 2)
  costPrice      Decimal?           @db.Decimal(12, 2)
  stockQty       Int                @default(0)
  reorderLevel   Int                @default(10)
  expiryDate     DateTime?
  unit           String             @default("pcs")
  available      Boolean            @default(true)
  organizationId String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  saleItems      PharmacySaleItem[]

  @@index([organizationId])
  @@index([organizationId, name])
  @@index([sku])
  @@index([expiryDate])
}

model PharmacySale {
  id             String             @id @default(cuid())
  total          Decimal            @db.Decimal(12, 2)
  paymentMethod  String?
  note           String?
  organizationId String
  staffId        String?
  createdAt      DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  items          PharmacySaleItem[]

  @@index([organizationId])
  @@index([createdAt])
}

model PharmacySaleItem {
  id        String           @id @default(cuid())
  saleId    String
  productId String?
  name      String
  quantity  Int
  price     Decimal          @db.Decimal(12, 2)
  product   PharmacyProduct? @relation(fields: [productId], references: [id])
  sale      PharmacySale     @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
}

model RecipeLine {
  id          String    @id @default(cuid())
  menuItemId  String
  stockItemId String
  qtyPerSale  Decimal   @db.Decimal(14, 4)
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: SetNull)

  @@unique([menuItemId, stockItemId])
  @@index([menuItemId])
  @@index([stockItemId])
}

model Branch {
  id             String       @id @default(cuid())
  name           String
  address        String?
  phone          String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  invites        Invite[]
  menuItems      MenuItem[]
  orders         Order[]
  stockItems     StockItem[]
  users          User[]

  @@index([organizationId])
}

model Book {
  id              String       @id @default(cuid())
  title           String
  author          String?
  isbn            String?
  category        String?
  imageUrl        String?
  copiesTotal     Int          @default(1)
  copiesAvailable Int          @default(1)
  organizationId  String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  loans           BookLoan[]

  @@index([organizationId])
  @@index([isbn])
  @@index([category])
}

model LibraryVisit {
  id             String       @id @default(cuid())
  visitorName    String
  phone          String?
  organizationId String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, visitorName])
}

model BookLoan {
  id             String       @id @default(cuid())
  bookId         String
  borrowerName   String
  nationalId     String
  phone          String?
  dueAt          DateTime?
  returnedAt     DateTime?
  organizationId String
  createdAt      DateTime     @default(now())
  book           Book         @relation(fields: [bookId], references: [id], onDelete: SetNull)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([bookId])
  @@index([dueAt])
  @@index([returnedAt])
}

model LibraryTable {
  id             String             @id @default(cuid())
  label          String
  seats          Int                @default(4)
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  reservations   TableReservation[]

  @@index([organizationId])
}

model TableReservation {
  id             String       @id @default(cuid())
  tableId        String
  guestName      String
  startsAt       DateTime
  endsAt         DateTime?
  organizationId String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  table          LibraryTable @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([tableId])
  @@index([startsAt])
}

model LibraryStudent {
  id             String              @id @default(cuid())
  fullName       String
  studentCode    String?
  grade          String?
  organizationId String
  createdAt      DateTime            @default(now())
  attendance     LibraryAttendance[]
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([studentCode])
}

model LibraryAttendance {
  id             String         @id @default(cuid())
  studentId      String
  organizationId String
  date           DateTime       @default(now())
  checkedInAt    DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  student        LibraryStudent @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([organizationId, date])
  @@index([studentId])
}

model LibraryReview {
  id             String       @id @default(cuid())
  visitorName    String
  rating         Int
  comment        String?
  organizationId String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
}

model SalonService {
  id             String          @id @default(cuid())
  name           String
  nameAm         String?
  category       String          @default("General")
  durationMin    Int             @default(30)
  price          Decimal         @db.Decimal(10, 2)
  active         Boolean         @default(true)
  organizationId String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  appointments   Appointment[]
  saleItems      SalonSaleItem[]
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, category])
}

model SalonStylist {
  id             String          @id @default(cuid())
  userId         String?         @unique
  fullName       String
  phone          String?
  specialty      String?
  commissionPct  Decimal         @default(0) @db.Decimal(5, 2)
  active         Boolean         @default(true)
  organizationId String
  createdAt      DateTime        @default(now())
  appointments   Appointment[]
  saleItems      SalonSaleItem[]
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?           @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
}

model Appointment {
  id             String            @id @default(cuid())
  clientName     String
  clientPhone    String?
  serviceId      String
  stylistId      String?
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(BOOKED)
  notes          String?
  organizationId String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  service        SalonService      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  stylist        SalonStylist?     @relation(fields: [stylistId], references: [id])

  @@index([organizationId, startsAt])
  @@index([stylistId, startsAt])
  @@index([status])
}

model SalonSale {
  id             String          @id @default(cuid())
  total          Decimal         @db.Decimal(12, 2)
  paymentMethod  String?
  appointmentId  String?
  organizationId String
  staffId        String?
  createdAt      DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  items          SalonSaleItem[]

  @@index([organizationId])
  @@index([createdAt])
}

model SalonSaleItem {
  id        String        @id @default(cuid())
  saleId    String
  serviceId String?
  stylistId String?
  name      String
  price     Decimal       @db.Decimal(12, 2)
  quantity  Int           @default(1)
  sale      SalonSale     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  service   SalonService? @relation(fields: [serviceId], references: [id])
  stylist   SalonStylist? @relation(fields: [stylistId], references: [id])

  @@index([saleId])
  @@index([serviceId])
  @@index([stylistId])
}

model SalonReview {
  id             String       @id @default(cuid())
  clientName     String
  rating         Int
  comment        String?
  organizationId String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
}

model GarmentStyle {
  id               String                   @id @default(cuid())
  name             String
  nameAm           String?
  sku              String?
  category         String?
  description      String?
  imageUrl         String?
  active           Boolean                  @default(true)
  organizationId   String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  bomItems         GarmentBOMItem[]
  productionOrders GarmentProductionOrder[]
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variants         GarmentVariant[]
  orderLines     GarmentOrderLine[] 

  @@index([organizationId])
  @@index([sku])
}

model GarmentVariant {
  id        String       @id @default(cuid())
  styleId   String
  size      String
  color     String
  colorAm   String?
  sku       String?
  barcode   String?
  price     Decimal      @default(0) @db.Decimal(12, 2)
  createdAt DateTime     @default(now())
  style     GarmentStyle @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@unique([styleId, size, color])
  @@index([styleId])
}

model GarmentMaterial {
  id             String                  @id @default(cuid())
  name           String
  nameAm         String?
  category       GarmentMaterialCategory
  unit           String
  currentStock   Decimal                 @default(0) @db.Decimal(14, 3)
  minLevel       Decimal?                @db.Decimal(14, 3)
  costPerUnit    Decimal?                @db.Decimal(12, 2)
  note           String?
  organizationId String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  bomItems       GarmentBOMItem[]
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([category])
}

model GarmentBOMItem {
  id         String          @id @default(cuid())
  styleId    String
  materialId String
  qtyNeeded  Decimal         @db.Decimal(14, 4)
  createdAt  DateTime        @default(now())
  material   GarmentMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  style      GarmentStyle    @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@unique([styleId, materialId])
  @@index([styleId])
  @@index([materialId])
}

model GarmentProductionOrder {
  id             String               @id @default(cuid())
  orderNumber    String
  styleId        String
  customerName   String?
  dueDate        DateTime?
  plannedQty     Int
  actualQty      Int                  @default(0)
  stage          ProductionStage      @default(PLANNED)
  status         ProductionStatus     @default(ON_TRACK)
  notes          String?
  organizationId String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  dailyReports   GarmentDailyReport[]
  defects        GarmentDefect[]
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  style          GarmentStyle?           @relation(fields: [styleId], references: [id])
  stageLogs      GarmentStageLog[]
  lines          GarmentOrderLine[]


  @@index([organizationId])
  @@index([stage])
  @@index([status])
  @@index([dueDate])
}

model GarmentOrderLine {
  id             String                  @id @default(cuid())
  orderId        String
  order          GarmentProductionOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  styleId        String
  style          GarmentStyle            @relation(fields: [styleId], references: [id])
  plannedQty     Int
  actualQty      Int                     @default(0)
  sizeNote       String?                 // e.g. "S=10, M=20, L=5"
  sortOrder      Int                     @default(0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([orderId])
  @@index([styleId])
}

model GarmentStageLog {
  id          String                 @id @default(cuid())
  orderId     String
  stage       ProductionStage
  quantity    Int
  note        String?
  createdAt   DateTime               @default(now())
  createdById String?
  order       GarmentProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model GarmentDefect {
  id             String                 @id @default(cuid())
  orderId        String
  defectType     DefectType
  quantity       Int
  stage          ProductionStage?
  note           String?
  estimatedCost  Decimal?               @db.Decimal(12, 2)
  createdById    String?
  organizationId String
  createdAt      DateTime               @default(now())
  order          GarmentProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([organizationId])
  @@index([createdAt])
}

model GarmentDailyReport {
  id             String                  @id @default(cuid())
  organizationId String
  userId         String?
  userName       String?
  orderId        String?
  stage          ProductionStage?
  quantity       Int
  note           String?
  reportDate     DateTime                @default(now())
  createdAt      DateTime                @default(now())
  order          GarmentProductionOrder? @relation(fields: [orderId], references: [id])
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, reportDate])
  @@index([userId])
  @@index([orderId])
}

model GarmentAttendance {
  id             String           @id @default(cuid())
  organizationId String
  userId         String?
  workDate       DateTime
  status         AttendanceStatus
  reason         String?
  note           String?
  markedById     String?
  source         String           @default("MANUAL")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  workerId       String?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  worker         GarmentWorker?   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([organizationId, workDate])
  @@index([workerId, workDate])
  @@index([userId, workDate])
}

model GarmentWorker {
  id              String              @id @default(cuid())
  organizationId  String
  name            String
  phone           String?
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  annualLeaveDays Int                 @default(14)
  usedLeaveDays   Int                 @default(0)
  attendances     GarmentAttendance[]
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model StockItem {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  unit           String          @default("kg")
  quantity       Decimal         @db.Decimal(14, 3)
  lowAt          Decimal?        @db.Decimal(14, 3)
  note           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  branchId       String?
  unitCost       Decimal?        @db.Decimal(14, 2)
  location       String          @default("STORE")
  recipeLines    RecipeLine[]
  branch         Branch?         @relation(fields: [branchId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movements      StockMovement[]

  @@index([organizationId])
  @@index([organizationId, location])
  @@index([branchId])
  @@index([name])
}

model StockMovement {
  id             String    @id @default(cuid())
  organizationId String
  stockItemId    String
  /// IN = receive, OUT = issue, COUNT = physical count, SALE = optional
  type           String
  quantity       Decimal   @db.Decimal(14, 3)
  balanceAfter   Decimal   @db.Decimal(14, 3)
  difference     Decimal?  @db.Decimal(14, 3)
  invoiceNo      String?
  note           String?
  userId         String?
  createdAt      DateTime  @default(now())
  fromWhere      String?
  toWhere        String?
  totalAmount    Decimal?  @db.Decimal(14, 2)
  unitPrice      Decimal?  @db.Decimal(14, 2)
  stockItem      StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([stockItemId, createdAt])
  @@index([type])
}

model SupportMessage {
  id             String        @id @default(cuid())
  body           String
  sender         SupportSender
  email          String?
  organizationId String?
  userId         String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

